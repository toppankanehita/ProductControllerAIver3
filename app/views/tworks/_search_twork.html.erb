 <div id="search_value" class="search-form-container">
      <%= search_form_for @q, url: tworks_path, method: :get do |f| %>
        <div class="d-flex flex-row flex-wrap align-items-center justify-content-start">

          <div class="p-2 bd-highlight d-flex align-items-center" style="width: 13%">
            <%= f.label :tinfo05_cont, '顧客名', class: 'form-label mb-0 me-2' %>
            <%= f.search_field :tinfo05_cont, class: 'form-control form-control-sm', style: 'width: 13em;' %>
          </div>

          <div class="p-2 bd-highlight d-flex align-items-center" style="width:10%">
            <%= f.label :den_code_start, '受注番号', class: 'form-label mb-0 me-2' %>
            <%= f.search_field :den_code_start, class: 'form-control form-control-sm', style: 'width: 8em;', placeholder: '250000-000' %>
          </div>

          <div class="p-2 bd-highlight d-flex align-items-center" style="width: 15%">
            <%= f.label :delivery_date_gteq, '納品日', class: 'form-label mb-0 me-2' %>

            <%# f.date_field を使えば、name属性や値の保持をRansackが自動で行います %>
            <%= f.date_field :delivery_date_gteq, class: 'form-control form-control-sm', style: 'width: 7em;' %>

            <%= f.label :delivery_date_lteq, '〜', class: 'form-label mb-0 ms-1 me-1' %>

            <%= f.date_field :delivery_date_lteq, class: 'form-control form-control-sm', style: 'width: 7em;' %>
          </div>

          <div class="p-2 bd-highlight d-flex align-items-center" style="width:10%">
            <%= f.label :staff_cont, '担当', class: 'form-label mb-0 me-2' %>
            <%= f.search_field :staff_cont, class: 'form-control form-control-sm', style: 'width: 8em;' %>
          </div>

          <%= f.hidden_field :info_cansel_eq, value: '0' %>
          <%= f.hidden_field :info_hold_eq, value: '0' %>

          <div class="p-2 bd-highlight d-flex align-items-center" style="width: 7%">
            <%= f.submit '検索', class: 'btn btn-sm btn-primary me-2' %>
            <div class="nav_total mb-0"><%= @tworks.total_count %>件</div>
          </div>
        </div>
      <% end %>
 </div>
