<%= form_with(model: size_list) do |form| %>
  <% if size_list.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(size_list.errors.count, "error") %> prohibited this size_list from being saved:</h2>

      <ul>
        <% size_list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :weight %>
    <%= form.text_field :weight %>
  </div>

  <div class="field">
    <%= form.label :kind %>
    <%= form.text_field :kind %>
  </div>

  <div class="field">
    <%= form.label :han %>
    <%= form.text_field :han %>
  </div>

  <div class="field">
