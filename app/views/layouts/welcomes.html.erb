<!DOCTYPE html>
<html>
  <head>
    <title>生産管理ツール</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
    <%= javascript_pack_tag 'application' %>
  </head>

  <body>
  <div class="d-flex flex-column flex-sm-row align-items-center p-3 ps-lg-5 pe-lg-5 px-sm-6 mb-3 bg-white border-bottom shadow-sm">
    <div class="d-flex flex-row flex-grow-2 ">
      <h5 class="my-0 mr-md-auto font-weight-normal"><%= link_to "生産管理ツール", root_path %></h5>
    </div>
<!--    <div class="d-flex flex-row flex-grow-2 ms-2">-->
<!--      <h5 class="my-0 mr-md-auto font-weight-normal"><%#= link_to "用紙登録", add_papers_add_values_path %></h5>-->
<!--    </div>-->

    <div class="d-flex flex-row flex-grow-2 ms-2">
      <h5 class="my-0 mr-md-auto font-weight-normal"><%= link_to "費用集計", add_values_path %></h5>
    </div>

    <div  class="d-flex flex-row flex-grow-1 justify-content-center">
      <nav class="pagination d-flex justify-content-center align-items-center" role="navigation" aria-label="pager" style="font-size: 90%;">
        <%= paginate @jobs %>
        <span style="margin-left:1em"><%= raw("#{@jobs.total_count}件 / #{@jobs.total_pages}page") %></span>
      </nav>
    </div>

    <div  class="d-flex flex-row-reverse flex-grow-4 ">
      <%= link_to "データ",press_data_path %>
    </div>
  </div>
  <div class="container" id="welcomes">
    <p class="notice"><%= notice %></p>
    <%= yield %>
  </div>
  </body>
</html>
