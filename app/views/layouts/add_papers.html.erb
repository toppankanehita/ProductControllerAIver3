<!DOCTYPE html>
<html>
<head>
  <title>生産管理ツール</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_pack_tag 'application', media: 'all' %>
  <%= javascript_pack_tag 'application' %>
</head>

<body>
<div class="d-flex flex-column flex-sm-row align-items-center ps-3 ps-lg-5 pe-lg-5 px-sm-6 mb-3 bg-white border-bottom shadow-sm">
  <div class="d-flex flex-row flex-grow-2 ">
    <h6 class="my-0 mr-md-auto font-weight-normal"><%= link_to "生産管理ツール", root_path %></h6>
  </div>

  <div class="d-flex flex-row flex-grow-2 ms-3">
    <h6 class="my-0 mr-md-auto font-weight-normal"><%= link_to "用紙登録（伝票）", jobs_path %></h6>
  </div>

  <div class="d-flex flex-row flex-grow-2 ms-3">
    <h6 class="my-0 mr-md-auto font-weight-normal"><%= link_to "週間", calendar_path %></h6>
  </div>

  <div class="d-flex flex-row flex-grow-2 ms-3">
    <h6 class="my-0 mr-md-auto font-weight-normal"><%= link_to "シートカッター", sheet_cutter_path %></h6>
  </div>

  <!-- 新規行を追加する簡易フォーム（必要なら受注No検索UIに置き換え） -->
  <div class="d-flex flex-row flex-grow-3 ms-5">
    <%= form_with url: add_values_path, method: :post, local: false,
                  authenticity_token: true,
                  html: { class: 'd-flex align-items-center flex-wrap gap-2' } do %>
      <%= label_tag :den_code, '受注No', class: 'mb-0 col-form-label col-form-label-sm' %>
      <%= text_field_tag :den_code, nil,
                         class: 'form-control form-control-sm',
                         placeholder: '250000-000',
                         style: 'width: 160px;' %>
      <%= submit_tag '追加', class: 'btn btn-sm btn-primary' %>
    <% end %>
  </div>

  <div  class="d-flex flex-row flex-grow-1 justify-content-center">
    <nav class="pagination d-flex justify-content-center align-items-center" role="navigation" aria-label="pager" style="font-size: 90%;">
      <%= paginate @add_values %>
      <span style="margin-left:1em"><%= raw("#{@add_values.total_count}件 / #{@add_values.total_pages}page") %></span>
    </nav>
  </div>

  <div  class="d-flex flex-row-reverse flex-grow-4 ">
    <%= link_to "データ",press_data_path %>
  </div>
</div>
<%= render partial: 'add_values/search_value' %>
<div class="container" style="margin-left: 0">
  <div id="add-values" style="padding-top: 0">
    <%= yield %>
  </div>
</div>

</body>
</html>
