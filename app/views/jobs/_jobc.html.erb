
<div id="<%= dom_id @job %>" class="job" style="">
  <div class="infowrap" style="background-color: #FFF">
    <div class="data_wap">
      <div class="data_wap d0101">
        <div class="midasi_inner">受注番号</div>
        <div class="data_innner">
          <%# @uploadfile %>
          <%# @job.blank? ? "" :  link_to(@job.den_id,"http://130.1.15.54:3000/jobs/show/#{@job.id}", target: "_blank") %>
          <%# fixed = Uploadfile.find_by("job_id = ? and life = ?",@job.id ,1 ) %>
          <% uploadfiles = Uploadfile.where("job_id = ? and life = ?",@job.id ,1 ) %>
          <% puts "--mount_chk_helper--" %>
          <% m = mount_chk_helper %>
          <% uploadfiles.each_with_index do |fixed,i| %>
            <% if fixed.present?  %>
              <% if m %>
                <%= link_to "積算書#{i + 1}", download_path(fixed), data: { confirm: "積算書登録をダウンロードします。" },style: "margin: 0;" %>
              <% else %>
                <%= link_to "積算書", "http://130.1.15.99:4000/uploadfiles/#{fixed.id}?user_id=23&account=tpnadmin&session=e507c5cd4784179ccc0d8581c21efc20", target: "_blank", rel: "noopener", data: { confirm: "積算書登録を開きます。" }, style: "margin: 0;" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="data_wap d0102">
        <div class="midasi_inner">顧客名</div>
        <div class="data_innner"><%= @job.blank? ? "" : @job.info.textInfo05 %></div>
      </div>
      <div class="data_wap d0103">
        <div class="midasi_inner">品名</div>
        <div class="data_innner"><%= @job.blank? ? "" : @job.info.textInfo07 %></div>
      </div>
      <div class="data_wap d0104">
