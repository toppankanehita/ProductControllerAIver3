        <div class="data_innner">
          <% if @job.present? %>
            <%= @job.info.textInfo20 %><br>
            <%= @job.info.numInfo06 %> × <%= @job.info.numInfo07 %>
          <% end %>
        </div>
      </div>
      <div class="data_wap d0105">
        <div class="midasi_inner">色数</div>
        <div class="data_innner">
          <% if @job.present? %>
            <%= @job.info.numInfo04 %> × <%= @job.info.numInfo05 %>
          <% end %>
        </div>
      </div>
      <div class="data_wap d0106">
