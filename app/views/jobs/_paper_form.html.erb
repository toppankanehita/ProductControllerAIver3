<div id="paper_wrap" class="table_wrap" style="overflow: hidden;margin-bottom: 0.5em ">
  <%= form_with(model: @value_form ,url: add_values_path, method: :post,  local: false) do |f| %>
  <table class="edit">

      <input type="hidden" name="id" value="<%= @job.id %>" >
      <input type="hidden" name="i" value="<%= @i %>" >
      <input type="hidden" name="ii" value="<%= @ii %>" >
      <input type="hidden" name="p" value="<%= params[:p] %>" >
      <input type="hidden" name="value_numInfo01" value="<%= @info.numInfo01 %>" id="value_numInfo01" >
      <input type="hidden" name="value_mihon" value="<%= mihon(@info) %>" id="value_mihon" >
      <input type="hidden" name="value_textInfo02" value="<%= @info.textInfo02 %>" id="value_textInfo02" >
      <input type="hidden" name="value_size" value="<%= @size %>" id="value_size" >
      <input type="hidden" name="value_size" value="<%= @info.numInfo04.blank? ? 0 : @info.numInfo04 %>" id="value_iroa" >
      <input type="hidden" name="value_size" value="<%= @info.numInfo05.blank? ? 0 : @info.numInfo05 %>" id="value_irob" >
      <input type="hidden" name="value_paper" value="<%= @info.textInfo11 %>" id="value_paper" >
      <% i = 1 %>
      <%= f.fields_for :add_values do |form| %>
        <% if i == 1 %>
          <tr>
            <th class="add" colspan="4">用紙名</th>
            <th class="add">連量</th>
            <th class="add">板紙</th>
            <th class="add">部数</th><th class="add">取数</th><th class="add">台</th>
            <th class="add">差替</th><th class="add">面</th>
            <th class="add">k単価</th><th class="add">枚単価</th>
            <th class="add">実数</th><th class="add">予備</th>
            <th class="add">用紙価格</th>
            <td colspan="2" rowspan="6" class="actions">
              <%= f.submit %>
              <%= link_to('更新', 'javascript:void(0);',onclick: "formchkd()") %>
            </td>
          </tr>
        <% end %>
        <tr>
          <%= form.hidden_field :position %>
          <%= form.hidden_field :job_id ,value: @job.id %>
          <td><%= i %></td>
          <td class="field mid" colspan="3"><%= form.text_field :paper_name %></td>
          <td class="field mid"><%= form.text_field :ren,size: 5 %></td>
          <td class="field mid"><%= form.check_box :ita ,{}, checked_value='1', unchecked_value='0' %></td>
          <td class="field mid"><%= form.text_field :press_num,size: 5 %></td>
          <td class="field mid"><%= form.text_field :tori,size: 3 %></td>
          <td class="field mid"><%= form.text_field :dai,size: 3 %></td>
          <td class="field mid"><%= form.text_field :sasi,size: 3 %></td>
          <td class="field mid"><%= form.text_field :men,size: 3 %></td>
          <td class="field mid"><%= form.text_field :ktanka,size: 3 %></td>
          <td class="field mid"><%= form.text_field :mtanka,size: 3 %></td>
          <td class="field mid iroy"><%= form.text_field :jisu,size: 5 %></td>
          <td class="field mid iroy"><%= form.text_field :yobi,size: 3 %></td>
          <td class="field mid iroy">
            <span><%=  %></span>
            <%= form.hidden_field :paper_price,size: 7 %>
          </td>
        </tr>
        <script>
            function formchkd<%= escape_javascript i %>(f){
                var posi = parseInt(<%= escape_javascript i %>) - 1;
                var paper_name = $("#form_add_value_collection_add_values_attributes_" + posi + "_paper_name");
                var ren = $("#form_add_value_collection_add_values_attributes_" + posi + "_ren").val();
                var ita = $("#form_add_value_collection_add_values_attributes_" + posi + "_ita:checked").val();
                var jisu = $("#form_add_value_collection_add_values_attributes_" + posi + "_jisu");
                var yobi = $("#form_add_value_collection_add_values_attributes_" + posi + "_yobi");
                var ktanka = $("#form_add_value_collection_add_values_attributes_" + posi + "_ktanka").val();
                var mtanka = $("#form_add_value_collection_add_values_attributes_" + posi + "_mtanka").val();
                var paper_price = $("#form_add_value_collection_add_values_attributes_" + posi + "_paper_price");
                var press_num = $("#form_add_value_collection_add_values_attributes_" + posi + "_press_num").val();
                var tori = $("#form_add_value_collection_add_values_attributes_" + posi + "_tori").val();
                var dai = $("#form_add_value_collection_add_values_attributes_" + posi + "_dai").val();
                var men = $("#form_add_value_collection_add_values_attributes_" + posi + "_men").val();
                var sasi = $("#form_add_value_collection_add_values_attributes_" + posi + "_sasi").val();
                var textInfo02 = $("#value_textInfo02").val();
                var size = $("#value_size").val();
                var jisu_num = 0;
                var yobi_num = 0;
                var dai_num = parseInt(dai);
                var tori_num = parseInt(tori);
                var paper = $("#value_paper").val();

                press_num = parseInt(press_num);
                if(f == 0){
                    if(dai_num > 0 && tori_num > 0 && press_num > 0){
                        jisu_num = Math.ceil((press_num / tori_num) * dai_num);

                        if(textInfo02 == "003　オフ輪"){
                            if( jisu_num < 30000 ){
                                yobi_num = (8000 / jisu_num) * jisu_num ;

                            } else if ( jisu_num > 130000){
                                yobi_num = (((0.069 - 0.04) * Math.exp(-0.00001 * (jisu_num-150000))) + 0.04)* jisu_num ;
                            } else {
                                yobi_num = (((0.26 - 0.07) * Math.exp(-0.000035 * (jisu_num-30000))) + 0.07)* jisu_num  ;
                            }

                            yobi_num = Math.ceil(yobi_num + ((sasi - 1) * 2000));
                            yobi_num = yobi_num / 2;

                        } else if(textInfo02 == "002　オフセット"){
                            if( jisu_num < 1500 ){
                                yobi_num = (300 / jisu_num) * jisu_num;
                            } else if (jisu_num < 20000){
                                yobi_num = ((0.22 - 0.075) * Math.exp(-0.0007 * (jisu_num-1500)) + 0.075) * jisu_num;
                            } else {
                                yobi_num = ((0.075 - 0.045) * Math.exp(-0.0001 * (jisu_num-20000)) + 0.045) * jisu_num;
                            }
                            yobi_num = Math.ceil(yobi_num/ men );
                        }else if(textInfo02 == "プリント出力"){
                            if( jisu_num < 1500){
                                yobi_num = (jisu_num) * 0.1;
                            } else if (jisu_num < 5000){
                                yobi_num = (jisu_num) * 0.05;
                            } else {
                                yobi_num = (jisu_num) * 0.02;
                            }
                            yobi_num = Math.ceil(yobi_num );
                        }
                    }
                } else {
                    if(dai_num > 0 && tori_num > 0 && press_num > 0){
                        jisu_num = Math.ceil(jisu.val());
                        yobi_num = Math.ceil(yobi.val());
                    }
                }

                weight = 0.0;
                price = parseInt(paper_price.val());

                mai = parseInt(jisu_num) + parseInt(yobi_num);

                if(ren !== ""){
                    weight = (mai / 1000 ) * parseFloat(ren);
                }

                if( ita == 1 ){
                    weight = weight * 10;
                }

                if(parseFloat(mtanka) > 0 ){
                    price = Math.round(mai * parseFloat(mtanka));
                } else if(parseFloat(ktanka) > 0 ) {
                    price = Math.round(parseFloat(ktanka) * weight);
                }
                if(textInfo02 == "003　オフ輪" && paper_name.val() == ""){
                    paper_name.val(paper);
                    console.log(paper);
                }
                yobi.val(yobi_num);
                jisu.val(jisu_num);
                paper_price.val(price);

            };
            var posi = parseInt(<%= escape_javascript i %>) - 1;
            var press_num01 = $("#value_numInfo01").val();
            var press_mihon = $("#value_mihon").val();
            var press_num = $("#form_add_value_collection_add_values_attributes_" + posi + "_press_num");
            if( press_num.val() == ""){
                press_num.val(parseInt(press_num01) + parseInt(press_mihon));
            }
            function vavaluechk<%= escape_javascript i %>(){

            }
            formchkd<%= escape_javascript i %>();
            var posi = parseInt(<%= escape_javascript i %>) - 1;
            var tt = "#form_add_value_collection_add_values_attributes_" + posi
            $(tt + "_ren , " + tt + "_jisu , " + tt + "_yobi , " + tt + "_ktanka , " + tt + "_mtanka , " + tt + "_ita , " + tt + "_tori , " + tt + "_dai , " + tt + "_press_num").bind('input', function () {
                formchkd<%= escape_javascript i %>(1);
            });

        </script>
        <% i = i + 1 %>
      <% end %>

  </table>
  <% end %>
</div>
<script>
    function formchkd(){
        formchkd1(0);
        formchkd2(0);
        formchkd3(0);
        formchkd4(0);
        formchkd5(0);
    }
</script>