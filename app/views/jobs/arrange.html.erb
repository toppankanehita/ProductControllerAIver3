<div id="arrange">

    <div id="main-container">
      <div id="canvas-container">
        <canvas id="myCanvas"></canvas>
        <div id="total-size-info"></div> </div>

      <div id="controls">
        <div class="section-header">用紙設定</div>
        <label for="canvasWidth">用紙の幅:</label>
        <div class="input-group">
          <input type="number" id="canvasWidth" value="<%= @grid_setting.canvas_width %>" min="100"> <span>mm</span>
        </div>

        <label for="canvasHeight">用紙の高さ:</label>
        <div class="input-group">
          <input type="number" id="canvasHeight" value="<%= @grid_setting.canvas_height %>" min="100"> <span>mm</span>
        </div>

        <div class="section-header">仕上設定</div>
        <label for="rectWidth">仕上幅:</label>
        <div class="input-group">
          <input type="number" id="rectWidth" value="<%= @grid_setting.rect_width %>" min="10"> <span>mm</span>
        </div>

        <label for="rectHeight">仕上高さ:</label>
        <div class="input-group">
          <input type="number" id="rectHeight" value="<%= @grid_setting.rect_height %>" min="10"> <span>mm</span>
        </div>

        <label for="cols">ヨコ数:</label>
        <div class="input-group">
          <input type="number" id="cols" value="<%= @grid_setting.cols %>" min="1">
        </div>

        <label for="rows">タテ数:</label>
        <div class="input-group">
          <input type="number" id="rows" value="<%= @grid_setting.rows %>" min="1">
        </div>

        <div class="section-header">アキ設定</div>
        <label for="baseHorizontalGap">ベース中アキ（横）:</label>
        <div class="input-group">
          <input type="number" id="baseHorizontalGap" value="<%= @grid_setting.base_horizontal_gap %>" min="0"> <span>mm</span>
        </div>

        <label for="baseVerticalGap">ベース中アキ（縦）:</label>
        <div class="input-group">
          <input type="number" id="baseVerticalGap" value="<%= @grid_setting.base_vertical_gap %>" min="0"> <span>mm</span>
        </div>

        <div class="even-gap-settings">
          <label for="centerPreHorizontalGap">偶数中アキ前（横）:</label>
          <div class="input-group">
            <input type="number" id="centerPreHorizontalGap" value="<%= @grid_setting.even_position_horizontal_gap %>" min="0"> <span>mm</span>
          </div>
          <label for="centerPreVerticalGap">偶数中アキ前（縦）:</label>
          <div class="input-group">
            <input type="number" id="centerPreVerticalGap" value="<%= @grid_setting.even_position_vertical_gap %>" min="0"> <span>mm</span>
          </div>
        </div>

        <label for="centerHorizontalGap">中央中アキ（横）:</label>
        <div class="input-group">
          <input type="number" id="centerHorizontalGap" value="<%= @grid_setting.center_horizontal_gap %>" min="0"> <span>mm</span>
        </div>

        <label for="centerVerticalGap">中央中アキ（縦）:</label>
        <div class="input-group">
          <input type="number" id="centerVerticalGap" value="<%= @grid_setting.center_vertical_gap %>" min="0"> <span>mm</span>
        </div>

        <%= hidden_field "job" ,:job_id , value: @job.id %>
        <label for="fixedPaddingBottom">クワエ:</label>
        <div class="input-group">
          <input type="number" id="fixedPaddingBottom" value="<%= @grid_setting.fixed_padding_bottom %>" min="0"> <span>mm</span>
        </div>

        <button id="drawButton">保存</button>
      </div>
    </div>
</div>

<%= javascript_pack_tag 'jobs/arrange' %>
