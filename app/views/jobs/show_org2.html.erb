                  var men = $("#form_add_value_collection_add_values_attributes_" + posi + "_men").val();
                  var sasi = $("#form_add_value_collection_add_values_attributes_" + posi + "_sasi").val();
                  var textInfo02 = $("#value_textInfo02").val();
                  var size = $("#value_size").val();
                  var jisu_num = 0;
                  var yobi_num = 0;
                  var dai_num = parseInt(dai);
                  var tori_num = parseInt(tori);
                  var paper = $("#value_paper").val();

                  press_num = parseInt(press_num);
                  if(f == 0){
                      if(dai_num > 0 && tori_num > 0 && press_num > 0){
                          jisu_num = Math.ceil((press_num / tori_num) * dai_num);

                          if(textInfo02 == "003　オフ輪"){
                              if( jisu_num < 30000 ){
                                  yobi_num = (8000 / jisu_num) * jisu_num ;

                              } else if ( jisu_num > 130000){
                                  yobi_num = (((0.069 - 0.04) * Math.exp(-0.00001 * (jisu_num-150000))) + 0.04)* jisu_num ;
                              } else {
                                  yobi_num = (((0.26 - 0.07) * Math.exp(-0.000035 * (jisu_num-30000))) + 0.07)* jisu_num  ;
                              }

                              yobi_num = Math.ceil(yobi_num + ((sasi - 1) * 2000));
                              yobi_num = yobi_num / 2;

                          } else if(textInfo02 == "002　オフセット"){
                              if( jisu_num < 1500 ){
                                  yobi_num = (300 / jisu_num) * jisu_num;
                              } else if (jisu_num < 20000){
                                  yobi_num = ((0.22 - 0.075) * Math.exp(-0.0007 * (jisu_num-1500)) + 0.075) * jisu_num;
                              } else {
                                  yobi_num = ((0.075 - 0.045) * Math.exp(-0.0001 * (jisu_num-20000)) + 0.045) * jisu_num;
                              }
                              yobi_num = Math.ceil(yobi_num/ men );
                          }else if(textInfo02 == "プリント出力"){
                              if( jisu_num < 1500){
                                  yobi_num = (jisu_num) * 0.1;
                              } else if (jisu_num < 5000){
                                  yobi_num = (jisu_num) * 0.05;
                              } else {
                                  yobi_num = (jisu_num) * 0.02;
                              }
                              yobi_num = Math.ceil(yobi_num );
                          }
                      }
                  } else {
                      if(dai_num > 0 && tori_num > 0 && press_num > 0){
                          jisu_num = Math.ceil(jisu.val());
                          yobi_num = Math.ceil(yobi.val());
                      }
                  }

                  weight = 0.0;
                  price = parseInt(paper_price.val());

                  mai = parseInt(jisu_num) + parseInt(yobi_num);

                  if(ren !== ""){
                      weight = (mai / 1000 ) * parseFloat(ren);
                  }

                  if( ita == 1 ){
                      weight = weight * 10;
                  }

                  if(parseFloat(mtanka) > 0 ){
                      price = Math.round(mai * parseFloat(mtanka));
                  } else if(parseFloat(ktanka) > 0 ) {
                      price = Math.round(parseFloat(ktanka) * weight);
                  }
                  if(textInfo02 == "003　オフ輪" && paper_name.val() == ""){
                      paper_name.val(paper);
                      console.log(paper);
                  }
                  yobi.val(yobi_num);
                  jisu.val(jisu_num);
                  paper_price.val(price);

              };
