                    }
                    if(irob == "1"){
                        kake2_num = kake2_num + 0.2;
                    }
                    if(irob == "0" || irob == "" ){
                        kake2_num = kake2_num + 0.5;
                    }
                }
                if(textInfo02 == "003　オフ輪" && jisu_num > 0){
                    kake2_num = kake2_num + ((sasi - 1 ) * (1500/ jisu_num) * iro_num)
                }
                console.log(kake2_num);
                var kake_num22 = parseInt((kake_num * kake2_num)*100)/100
                if(kake_num > 0 && jisu_num > 0 && iro_num > 0 && dai > 0){
                    console.log("jisu_num" + jisu_num + "tanka_num" + tanka_num + "kake_num" + kake_num + "iro_num" + iro_num);
                    dai_price_num = parseInt( (jisu_num * (tanka_num * kake_num)) * iro_num);
                }
                if(dai > 0 && men > 0 && press_num > 0){
                    if(textInfo02 == "003　オフ輪"){
                        if(dai_price_num < 60000){
                            tanka_num = 0;
                            dai_price_num = 60000;
                            dtanka_num = parseInt(60000 / iro_num)
                        }
                    } else if(textInfo02 == "002　オフセット"){
                        if(sheet_limit > 0 && jisu_num * tanka_num < sheet_limit ){
                            tanka_num = 0;
                            dtanka_num = sheet_limit;
                            dai_price_num = (sheet_limit * iro_num);
                        }
                    }
                }
                dai_price_num = parseInt(dai_price_num * kake2_num);
                tanka.val(tanka_num);
                kake.val(kake_num);
                kake2.val(kake2_num);
                jisu.val(jisu_num);
                daitanka.val(dtanka_num);
                dai_price.val(dai_price_num);
            }
            var posi = parseInt(<%= escape_javascript i %>) - 1;
            var press_num01 = $("#value_numInfo01").val();
            var press_mihon = $("#value_mihon").val();
            var press_num = $("#form_add_press_collection_add_presses_attributes_" + posi + "_press_num");
            if( press_num.val() == ""){
                press_num.val(parseInt(press_num01) + parseInt(press_mihon));
            }
            var iroa = $("#form_add_press_collection_add_presses_attributes_" + posi + "_iroa");
            var irob = $("#form_add_press_collection_add_presses_attributes_" + posi + "_irob");
            iroa.val($("#value_iroa").val());
            irob.val($("#value_irob").val());
        </script>
        <% i = i + 1 %>
      <% end %>
    <% end %>
