<p id="notice"><%= notice %></p>

<h1>Debits</h1>

<table>
  <thead>
    <tr>
      <th>Target month</th>
      <th>Den code</th>
      <th>Job</th>
      <th>Siwake</th>
      <th>Name</th>
      <th>Out cost</th>
      <th>In cost</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @debits.each do |debit| %>
      <tr>
        <td><%= debit.target_month %></td>
        <td><%= debit.den_code %></td>
        <td><%= debit.job_id %></td>
        <td><%= debit.siwake %></td>
        <td><%= debit.name %></td>
        <td><%= debit.out_cost %></td>
        <td><%= debit.in_cost %></td>
        <td><%= link_to 'Show', debit %></td>
        <td><%= link_to 'Edit', edit_debit_path(debit) %></td>
        <td><%= link_to 'Destroy', debit, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Debit', new_debit_path %>
