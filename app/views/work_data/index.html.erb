<div id="search_value" class="search-form-container" style="min-width: 1800px;">
  <div class="d-flex flex-row justify-content-start">
    <div class="sum_inner"><span>合計売上:</span><%= numformat1(@sales_sum) %></div>
    <div class="sum_inner"><span>合計費用:</span><%= numformat1(@cost_sum) %></div>
    <div class="sum_inner"><span>合計粗利:</span><%= numformat1(@profit_sum) %></div>
    <div class="sum_inner"><span>粗利率:</span><%= number_to_percentage(@profit_par,  precision: 2) %></div>
  </div>
</div>
<table class="a_index" id="add_values_index">
  <thead>
  <tr>
    <th rowspan=2 style="min-width: 30px" class="mid">売上月</th>
    <th rowspan=2 style="min-width: 50px">所属</th>
    <th rowspan=2 style="min-width: 60px">種類</th>
    <th rowspan=2 style="min-width: 85px">受注No</th>
    <th rowspan=2 style="min-width: 130px">得意先名</th>
    <th rowspan=2 style="min-width: 150px">品名</th>
    <th rowspan=2 style="min-width: 60px">担当</th>
    <th colspan=3>製造仕入高</th>
    <th>賃借料</th>
    <th rowspan=2 style="min-width: 50px">外注費</th>
    <th rowspan=2 style="min-width: 50px">仕入高</th>
    <th colspan=8>労務費</th>
    <th colspan=2>雑給</th>
    <th colspan=1>間接費</th>

  </tr>
  <tr>
    <th style="min-width: 50px">用紙</th>
    <th style="min-width: 50px">刷版</th>
    <th style="min-width: 50px">材料費計</th>
    <th style="min-width: 50px">POD</th>

    <th style="min-width: 50px">製造時間</th>
    <!--    <th style="min-width: 50px">賃率</th>-->
    <th style="min-width: 50px">労務費</th>
    <th style="min-width: 50px">制作時間</th>
    <!--    <th style="min-width: 50px">賃率</th>-->
    <th style="min-width: 50px">労務費</th>
    <th style="min-width: 50px">デザイン時間</th>
    <!--    <th style="min-width: 50px">賃率</th>-->
    <th style="min-width: 50px">労務費</th>
    <th style="min-width: 50px">作業時間計</th>
    <th style="min-width: 50px">労務費計</th>
    <th style="min-width: 50px">アセンブリ労務時間</th>
    <!--    <th style="min-width: 50px">賃率</th>-->
    <th style="min-width: 50px">雑給</th>
    <th style="min-width: 50px">間接費合計</th>
    <th style="min-width: 50px">運賃</th>
    <th style="min-width: 50px">合計</th>
    <th style="min-width: 50px">売上</th>
    <th style="min-width: 50px">粗利</th>
    <th style="min-width: 50px">粗利率</th>

  </tr>
  </thead>

  <tbody>
  <% @mission_archives.each do |mission_archive| %>
    <tr>
      <td style="text-align: center"><%= mission_archive.target_month %></td>
      <td style="text-align: center"><%= mission_archive.mission_archive_01 %></td>
      <td style="text-align: center"><%= mission_archive.mission_archive_02 %></td>
      <td style="text-align: center"><%= mission_archive.mission_archive_03 %></td>
      <td><%= mission_archive.mission_archive_04 %></td>
      <td><%= mission_archive.mission_archive_05 %></td>
      <td style="text-align: center"><%= mission_archive.mission_archive_06 %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_07) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_08) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_09) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_10) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_11) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_12) %></td>
      <td style="text-align: right"><%= number_with_precision(mission_archive.mission_archive_13, precision: 1) %></td>
      <!--        <td style="text-align: right"><%#= numformat1(mission_archive.mission_archive_14) %></td>-->
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_15) %></td>
      <td style="text-align: right"><%= number_with_precision(mission_archive.mission_archive_16, precision: 1) %></td>
      <!--        <td style="text-align: right"><%#= numformat1(mission_archive.mission_archive_17) %></td>-->
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_18) %></td>
      <td style="text-align: right"><%= number_with_precision(mission_archive.mission_archive_19, precision: 1) %></td>
      <!--        <td style="text-align: right"><%#= numformat1(mission_archive.mission_archive_20) %></td>-->
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_21) %></td>
      <td style="text-align: right"><%= number_with_precision(mission_archive.mission_archive_22, precision: 1) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_23) %></td>
      <td style="text-align: right"><%= number_with_precision(mission_archive.mission_archive_24, precision: 1) %></td>
      <!--        <td style="text-align: right"><%#= numformat1(mission_archive.mission_archive_25) %></td>-->
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_26) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_41) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_42) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_43) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_44) %></td>
      <td style="text-align: right"><%= numformat1(mission_archive.mission_archive_45) %></td>
      <td style="text-align: right"><%= number_to_percentage(mission_archive.mission_archive_46.to_f * 100,  precision: 1) %></td>
    </tr>
  <% end %>
  </tbody>
</table>

