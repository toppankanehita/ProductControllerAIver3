<% i = 1 %>
<table class="a_index" id="add_values_index">
  <thead>
    <tr>
      <th rowspan=2 style="min-width: 30px" class="mid">No</th>
      <th rowspan=2 style="min-width: 50px">所属</th>
      <th rowspan=2 style="min-width: 60px">種類</th>
      <th rowspan=2 style="min-width: 85px">受注No</th>
      <th rowspan=2 style="min-width: 130px">得意先名</th>
      <th rowspan=2 style="min-width: 150px">品名</th>
      <th colspan=3>製造仕入高</th>
      <th>賃借料</th>
      <th rowspan=2 style="min-width: 50px">外注費</th>
      <th rowspan=2 style="min-width: 50px">仕入高</th>
      <th colspan=11>労務費</th>
      <th colspan=3>雑給</th>
      <th colspan=14>間接費</th>

    </tr>
    <tr>
      <th style="min-width: 50px">用紙</th>
      <th style="min-width: 50px">刷版</th>
      <th style="min-width: 50px">材料費計</th>
      <th style="min-width: 50px">POD</th>

      <th style="min-width: 50px">製造時間</th>
      <th style="min-width: 50px">賃率</th>
      <th style="min-width: 50px">労務費</th>
      <th style="min-width: 50px">制作時間</th>
      <th style="min-width: 50px">賃率</th>
      <th style="min-width: 50px">労務費</th>
      <th style="min-width: 50px">デザイン時間</th>
      <th style="min-width: 50px">賃率</th>
      <th style="min-width: 50px">労務費</th>
      <th style="min-width: 50px">作業時間計</th>
      <th style="min-width: 50px">労務費計</th>
      <th style="min-width: 50px">アセンブリ労務時間</th>
      <th style="min-width: 50px">賃率</th>
      <th style="min-width: 50px">雑給</th>
      <th style="min-width: 50px">材料費</th>
      <th style="min-width: 50px">労務費</th>
      <th style="min-width: 50px">賞与</th>
      <th style="min-width: 50px">法定福利</th>
      <th style="min-width: 50px">水道光熱費</th>
      <th style="min-width: 50px">修繕費</th>
      <th style="min-width: 50px">租税公課</th>
      <th style="min-width: 50px">保険料</th>
      <th style="min-width: 50px">消耗品費</th>
      <th style="min-width: 50px">車両費</th>
      <th style="min-width: 50px">通信費</th>
      <th style="min-width: 50px">減価償却費</th>
      <th style="min-width: 50px">雑費</th>
      <th style="min-width: 50px">間接費合計</th>
      <th style="min-width: 50px">運賃</th>
      <th style="min-width: 50px">合計</th>
      <th style="min-width: 50px">売上</th>
      <th style="min-width: 50px">粗利</th>
      <th style="min-width: 50px">粗利率</th>
      <th style="min-width: 100px">担当</th>
    </tr>
  </thead>
  <tbody>
  <% @jobs.each do |job| %>
    <%= render partial: 'mission', locals: {  job: job, i: i } %>
    <% i += 1 %>
  <% end %>
  </tbody>
</table>

<div id="mask" class="hidden"></div>
<div id="modal" class="hidden modal-dialog-fluid"></div>

<!-- AddValue rows modal -->
<div class="modal fade" id="addValueModal" tabindex="-1" aria-labelledby="addValueModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <style>
          <!--
          .nodialog{
              display: none;
          }

          -->
      </style>
      <div class="modal-header">
        <h5 class="modal-title" id="addValueModalLabel">用紙明細</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="text-muted">読み込み中...</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
      </div>
    </div>
  </div>
</div>

<!-- Parent Code Modal -->
<div class="modal fade" id="parentCodeModal" tabindex="-1" aria-labelledby="parentCodeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="parentCodeModalLabel">親コード登録</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="text-muted">読み込み中...</div>
      </div>
    </div>
  </div>
</div>

<%= javascript_pack_tag 'addValues/index' %>
<%= javascript_pack_tag 'jobs/add_datum' %>


