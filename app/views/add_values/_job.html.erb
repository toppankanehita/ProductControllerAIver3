  <td style="text-align: right"><%= numformat1(@tmp_array[4]) %></td>
  <td style="text-align: right"><%= numformat1(@tmp_array[5]) %></td>
  <td style="text-align: right"><%= numformat1(@tmp_array[6]) %></td>
  <td style="text-align: right"><%= numformat1(@tmp_array[7]) %></td>
  <td style="text-align: right"><%= numformat1(@tmp_array[8]) %></td>
  <td style="text-align: right"><%= numformat1(@tmp_array[9]) %></td>
