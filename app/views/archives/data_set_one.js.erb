// UJS (Rails.ajax) 応答: 対象の tbody を差し替え
$("#<%= dom_id(@archive, :rows) %>").replaceWith("<%= j(
  render(partial: 'archive_rows', locals: {
    i: 1,
    ii: ((@per_page || 12) * ((params[:page].blank? ? 1 : params[:page].to_i) - 1)),
    job: Job.find_by(id: @archive.job_id),
    archive: @archive
  })
) %>");
