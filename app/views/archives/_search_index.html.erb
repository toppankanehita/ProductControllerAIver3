<div id="search_value" class="search-form-container" style="min-width: 1800px;">
  <%= search_form_for @q, url: archives_path  do |f| %>
    <div class="d-flex flex-row justify-content-start">
      <div class="p-2 bd-highlight d-flex align-items-center" style="width:10%" >
        <%= label_tag 'q_info[den_id_start]', '受注番号', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :den_id_start ,style:"width:8em", class: 'form-control form-control-sm',placeholder: '250000-000' %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 12.5%" >
        <%= label_tag 'q_info[textInfo05_cont]', '顧客名', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :textInfo05_cont ,style:"width:13em", class: 'form-control form-control-sm' %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 12.5%">
        <%= label_tag 'q_info[textInfo07_cont]', '案件名', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :textInfo07_cont ,style:"width:13em", class: 'form-control form-control-sm' %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 10%">
        <%= label_tag 'q_info[textInfo02_cont]', '印刷方法', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :textInfo02_cont, list: 'print_method_list',style:"width:7em", class: 'form-control form-control-sm', placeholder: '選択または入力' %>
        <%= tag.datalist id: 'print_method_list' do %>
          <%= tag.option 'オフ輪' %>
          <%= tag.option 'オフセット' %>
          <%= tag.option 'プリント' %>
          <%= tag.option 'その他' %>
        <% end %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 10%" >
        <%= label_tag 'q_info[textInfo11_cont]', '用紙', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :textInfo11_cont ,style:"width:9em", class: 'form-control form-control-sm' %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 15%" >
        <%= label_tag 'q_info[cal_paper_gt]', '用紙コスト比率', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :cal_paper_gt ,style:"width:5em", class: 'form-control form-control-sm' %>%以上
      </div>


      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 15%" >
        <%= label_tag 'q_info[press_date_gteq]', '印刷日', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :press_date_gteq ,style:"width:7em", class: 'form-control form-control-sm', type: 'date' %>
        <%= label_tag 'q_info[press_date_lteq]', '〜', class: 'form-label mb-0 ms-1 me-1' %>
        <%= f.search_field :press_date_lteq ,style:"width:7em", class: 'form-control form-control-sm', type: 'date' %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 15%">
        <%= label_tag 'q_info[finish_date_gteq]', '納品日', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :finish_date_gteq ,style:"width:7em", class: 'form-control form-control-sm', type: 'date' %>
        <%= label_tag 'q_info[finish_date_lteq]', '〜', class: 'form-label mb-0 ms-1 me-1' %>
        <%= f.search_field :finish_date_lteq ,style:"width:7em", class: 'form-control form-control-sm', type: 'date' %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 15%">
        <%= label_tag 'q_info[sale_date_gteq]', '売上日', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :sale_date_gteq ,style:"width:7em", class: 'form-control form-control-sm', type: 'date' %>
        <%= label_tag 'q_info[sale_date_lteq]', '〜', class: 'form-label mb-0 ms-1 me-1' %>
        <%= f.search_field :sale_date_lteq ,style:"width:7em", class: 'form-control form-control-sm', type: 'date' %>
      </div>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 7%">
        <%= label_tag 'q_info[sale_sname_cont]', '担当', class: 'form-label mb-0 me-2' %>
        <%= f.search_field :sales_name_cont ,style:"width:5em", class: 'form-control form-control-sm' %>
      </div>

      <%= f.hidden_field :info_cansel_eq, value: "0" %>
      <%= f.hidden_field :info_hold_eq, value: "0" %>

      <div class="p-2 bd-highlight d-flex align-items-center" style="width: 7%">
        <%= f.submit '検索', class: 'btn btn-sm btn-primary me-2' %>
        <div class="nav_total mb-0"><%= @archives.total_count %>件</div>
      </div>
    </div>
  <% end %>
</div>