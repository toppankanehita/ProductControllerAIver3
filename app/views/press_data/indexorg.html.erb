<p id="notice"><%= notice %></p>

<h1>印刷実績</h1>

<div class="link_warp">
  <div class="link_item">
    <%= link_to '作業伝票とリンク', job_link_press_data_path %>
  </div>
  <div class="link_item">
    <%= link_to '印刷履歴取り込み', get_data_press_data_path() %>
  </div>
</div>


<%= paginate @press_data %><%= "#{@press_data.total_pages}page / #{@press_data.total_count}件" %>
<table>
  <thead>
    <tr>
      <th>機種</th>
      <th>受注No</th>
      <th>案件名</th>
      <th>Paper no</th>
      <th>開始時間</th>
      <th>印刷時間</th>
      <th>印刷枚数</th>
      <th>損紙</th>

<!--      <th colspan="3"></th>-->
    </tr>
  </thead>

  <tbody>
    <% @press_data.each do |press_data| %>
      <tr>
        <td><%= press_data.machine %></td>
        <td><%= press_data.den_code %></td>
        <td><%= press_data.product_name %></td>
        <td><%= press_data.paper_no %></td>
        <td><%= press_data.start_time %></td>
        <td><%= press_data.work_time %></td>
        <td><%= press_data.n01 %></td>
        <td><%= press_data.n02 %></td>

<!--        <td><%#= link_to 'Show', press_data %></td>-->
<!--        <td><%#= link_to 'Edit', edit_press_datum_path(press_data) %></td>-->
<!--        <td><%#= link_to 'Destroy', press_data, method: :delete, data: { confirm: 'Are you sure?' } %></td>-->
      </tr>
    <% end %>
  </tbody>
</table>

<br>

